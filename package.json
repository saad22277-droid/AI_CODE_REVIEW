{
  "name": "ai-code-review",
  "version": "0.1.0",
  "description": "Hybrid AI + static-analysis code review, shippable as a GitHub Action or a local CLI. Supports Gemini and Claude.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "ai-code-review": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && ncc build src/index.ts -o dist",
    "typecheck": "tsc -p tsconfig.eval.json",
    "start": "node dist/index.js",
    "cli": "ts-node src/cli.ts",
    "eval": "ts-node eval/runEval.ts",
    "test": "node --test --require ts-node/register tests/**/*.test.ts",
    "lint": "eslint src --ext .ts"
  },
  "files": [
    "dist",
    "semgrep-rules",
    "action.yml",
    ".aicodereview.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "@octokit/rest": "^20.1.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
